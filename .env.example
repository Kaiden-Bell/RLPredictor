# Required: Liquipedia asks API clients to identify themselves with contact info.
LIQUIPEDIA_USER_AGENT="RLPredictor/0.2 (your-email@example.com)"

# Optional: enables the player-value factor (https://ballchasing.com/upload -> API token).
BALLCHASING_API_KEY=

# Optional: community sentiment context (https://www.reddit.com/prefs/apps -> "script" app).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT="script:rlpredictor:0.2 (by /u/your_username)"
